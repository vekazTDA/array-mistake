# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Array
# ---------------------------------------------------------------------------

# Array client id, from Array's onboarding email. Not read by any code today —
# recorded because Array's support threads ask for it.
ARRAY_CLIENT_ID=

# Public. Array's docs pass this as a query param on the component script tag,
# so it is visible in the browser by design, and NEXT_PUBLIC_ inlines it into
# the client bundle. Not a secret.
NEXT_PUBLIC_ARRAY_APP_KEY=

# "true"  -> embed.sandbox.array.io + Array's fictitious test identities
# "false" -> embed.array.io + real bureau data and real per-pull billing
NEXT_PUBLIC_ARRAY_SANDBOX=true

# Server-side only. Never expose to the browser.
#
# TODO: Array sent Client ID / AppKey / Client Token. The token-regeneration
# endpoint wants an "x-array-server-token" header, which is not obviously any
# of those three. Confirm whether the Client Token is the server token, or
# whether a fourth credential is outstanding.
ARRAY_SERVER_TOKEN=

# Base host for Array's REST API.
# Sandbox is documented as https://sandbox.array.io
# TODO: confirm the production host with Array before going live.
ARRAY_API_BASE=https://sandbox.array.io

# Minutes until a regenerated userToken expires. Array caps this at 60.
ARRAY_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER give this a NEXT_PUBLIC_ prefix — it bypasses row
# level security for every table.
#
# Used in exactly one place: src/lib/supabase/admin.ts, which is only reached
# from /api/admin/* after requireSuperAdmin() confirms the caller's role.
# Every other server route runs under the signed-in staff member's own
# session and needs no elevated access — this key exists because creating a
# staff account with a password the admin chose requires the Supabase Admin
# API, and there is no lower-privilege way to do that for someone else.
#
# Get it from Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Array egress relay (optional)
# ---------------------------------------------------------------------------
#
# Array allowlists source IPs. Vercel serverless has no static outbound
# address, so the token call is refused from a deployment and succeeds from an
# allowlisted office connection.
#
# Set these to route that one call through relay/server.mjs, running at the
# allowlisted location. Leave both empty to call Array directly — which is what
# you want as soon as Array allowlists a permanent egress IP.
#
# ARRAY_RELAY_URL=https://<tunnel-hostname>/array/usertoken
# ARRAY_RELAY_SECRET=

# Bureaus used for identity verification.
#
# "all"  -> tui + exp + efx. Better verification success rate, and required
#           for most of Array's sandbox identities, which only verify when
#           every bureau they list is passed as a provider.
# unset  -> TransUnion only. Matches the contracted TU 3B scope exactly, but
#           anyone TransUnion cannot recognise fails with no fallback.
#
# Still open with Array: which is intended for this contract.
# NEXT_PUBLIC_ARRAY_BUREAUS=all
